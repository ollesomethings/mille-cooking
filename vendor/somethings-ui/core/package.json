{
  "name": "@somethings-ui/core",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./assets": {
      "react-native": "./src/assets/index.native.ts",
      "types": "./src/assets/index.ts",
      "default": "./src/assets/index.ts"
    },
    "./swap-prompts": {
      "react-native": "./src/swap-prompts/index.native.ts",
      "types": "./src/swap-prompts/index.ts",
      "default": "./src/swap-prompts/index.ts"
    },
    "./hot-takes": {
      "types": "./src/hot-takes/index.ts",
      "default": "./src/hot-takes/index.ts"
    },
    "./connect-questions": {
      "types": "./src/connect-questions/index.ts",
      "default": "./src/connect-questions/index.ts"
    },
    "./deep-thoughts": {
      "types": "./src/deep-thoughts/index.ts",
      "default": "./src/deep-thoughts/index.ts"
    },
    "./src/deep-thoughts": {
      "types": "./src/deep-thoughts/index.ts",
      "default": "./src/deep-thoughts/index.ts"
    },
    "./src/connect-questions": {
      "types": "./src/connect-questions/index.ts",
      "default": "./src/connect-questions/index.ts"
    },
    "./src/assets": {
      "react-native": "./src/assets/index.native.ts",
      "types": "./src/assets/index.ts",
      "default": "./src/assets/index.ts"
    },
    "./src/swap-prompts": {
      "react-native": "./src/swap-prompts/index.native.ts",
      "types": "./src/swap-prompts/index.ts",
      "default": "./src/swap-prompts/index.ts"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "src/**/*"
  ]
}
